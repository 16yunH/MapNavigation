VITE_API_BASE_URL=http://localhost:8081

# Gaode JavaScript API key. This value is embedded in the browser bundle and
# must be protected with an allowed-domain whitelist in the Gaode console.
VITE_AMAP_JS_KEY=replace-with-your-gaode-js-api-key

# Recommended for production: an HTTPS reverse-proxy endpoint ending in
# /_AMapService. Keep the securityJsCode on that server instead of in the app.
VITE_AMAP_SERVICE_HOST=https://maps-api.example.com/_AMapService

# Local development fallback only. This value is embedded in the browser bundle;
# do not use this plaintext mode for production deployments.
VITE_AMAP_SECURITY_CODE=replace-with-your-gaode-security-code
